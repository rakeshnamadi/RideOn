# RideOn configuration. Copy to `.env` and fill in real values.
# Never commit `.env`. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
API_PORT=4000
# Comma-separated list of origins allowed to call the API (the web app).
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting).
TRUST_PROXY=0

# ── Database (MySQL 8.0+) ──
DATABASE_URL=mysql://rideon:CHANGE_ME@127.0.0.1:3307/rideon
# Used only by the automated tests. The database name must end in "test".
TEST_DATABASE_URL=mysql://rideon:CHANGE_ME@127.0.0.1:3307/rideon_test

# ── Authentication ──
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_REFRESH_PEPPER=CHANGE_ME_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# ── Files ──
# Private storage for driver documents. Must not be inside any web-served directory.
UPLOAD_DIR=./uploads

# ── Logging ──
LOG_LEVEL=info

# ── Maps (server side) ──
# Geocoding: nominatim | none. Public Nominatim allows max 1 req/s and requires an identifying
# User-Agent with contact details; use a hosted/self-hosted provider in production.
GEOCODING_PROVIDER=nominatim
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=RideOn/0.1 (contact: ops@your-domain.example)
# Routing: osrm | none. The public OSRM demo server is for development only.
ROUTING_PROVIDER=osrm
ROUTING_URL=https://router.project-osrm.org
PROVIDER_TIMEOUT_MS=4000

# ── Payments ──
# mock (development only — refused when NODE_ENV=production) | none (cash only).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_16_CHARS

# Run background jobs (dispatch sweeps, hold expiry, departures) in this process.
JOBS_ENABLED=true

# ── Web app (build time, Vite) ──
# Tile server for Leaflet. The default public OSM tile server is for light development use only.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
